    {
      "tool": "ExitWorktree",
      "decl": "ExitWorktreeInput",
      "side": "input",
      "class": "instruction",
      "kind": "description-changed",
      "field": "action",
      "before": "\"keep\" leaves the worktree and branch on disk; \"remove\" deletes both.",
      "after": "\"keep\" leaves the worktree and branch on disk; \"remove\" deletes the worktree and, unless a hook made it or git refuses, its branch.",
      "display": "ExitWorktree.action"
    },
    {
      "tool": "ExitWorktree",
      "decl": "ExitWorktreeInput",
      "side": "input",
      "class": "instruction",
      "kind": "description-changed",
      "field": "discard_changes",
      "before": "Required true when action is \"remove\" and the worktree has uncommitted files or unmerged commits. The tool will refuse and list them otherwise.",
      "after": "Required true when action is \"remove\" and the worktree has uncommitted files or unmerged commits. The tool will refuse and list them otherwise. It also removes the worktree under any task still running there, so set it only after the user has confirmed.",
      "display": "ExitWorktree.discard_changes"
    },
    {
      "tool": "ProposeGoal",
      "decl": "ProposeGoalInput",
      "side": "input",
      "class": "instruction",
      "kind": "description-changed",
      "field": "ask_user",
      "before": "Whether to ask the user for approval before the goal is set. Defaults to true — an approval dialog is shown. Set false ONLY when the user's own words in this conversation stated this outcome as what they want; the goal is then set directly, with a visible notice in the transcript, and the user can clear it with /goal clear.",
      "after": "Whether to ask the user for approval before the goal is set. Defaults to true — an approval dialog is shown. Set false ONLY when the user's own words in this conversation stated this outcome as what they want; the goal is then set directly, with a visible notice in the transcript, and the user can clear it with /goal clear. While a goal is active the dialog is shown whatever this says.",
      "display": "ProposeGoal.ask_user"
    },
    {
      "tool": "ProposeGoal",
      "decl": "ProposeGoalInput",
      "side": "input",
      "class": "instruction",
      "kind": "description-changed",
      "field": "condition",
      "before": "The completion condition to propose, written so a separate evaluator can verify it from the conversation (e.g. \"all tests in test/auth pass (bun test exits 0)\"). At most 500 characters — the user must be able to read the whole condition in the approval dialog.",
      "after": "The completion condition to set, written so a separate evaluator can verify it from the conversation (e.g. \"all tests in test/auth pass (bun test exits 0)\"). At most 500 characters — the user must be able to read the whole condition in the approval dialog.",
      "display": "ProposeGoal.condition"
    },
    {
      "tool": "Workflow",
      "decl": "WorkflowInput",
      "side": "input",
      "class": "instruction",
      "kind": "description-changed",
      "field": "resumeFromRunId",
      "before": "Run ID of a prior Workflow invocation to resume from. Completed agent() calls with unchanged (prompt, opts) return their cached results instantly; only edited or new calls re-run. Same-session only. Stop the prior run first (TaskStop) before resuming.",
      "after": "Run ID of a prior Workflow invocation to resume from. The cache is positional: agent() calls replay from cache up to the first call that failed, no longer matches the earlier run (edited, added, removed or reordered) or never started in it; that call and every call after it run again, even when their own (prompt, opts) are unchanged. A call a usage limit refused, or one still running when the run stopped, usually runs again without ending reuse: finished calls after it still come from cache. Same-session only. Stop the prior run first (TaskStop) before resuming.",
      "display": "Workflow.resumeFromRunId"
    },
