  "description": "Config Drift Checker for coding-agent setups: run, diff and report claude plugin eval suites from any CI",
  "license": "SEE LICENSE IN LICENSE",
  "repository": { "type": "git", "url": "https://github.com/jameskomo/config-drift-checker" },
